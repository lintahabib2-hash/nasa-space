{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "crew-vitals/api-response@1",
  "title": "Crew Vitals common analytics response",
  "description": "What /api/baseline returns for one indicator: Member 2's get_baseline_result() output plus 'no_observations'. Extra analytics fields are allowed so Member 2 can add detail without a contract change. Owner: Member 6.",
  "type": "object",
  "required": ["subject_id", "measurement", "status", "quality_state", "reasons", "severity_basis", "not_medical_diagnosis"],
  "properties": {
    "subject_id": { "type": "string" },
    "measurement": { "type": "string" },
    "source_id": { "type": ["string", "null"] },
    "study_id": { "type": ["string", "null"] },
    "provenance_kind": { "type": ["string", "null"] },
    "units": { "type": ["string", "null"] },
    "status": { "enum": ["no_persistent_flag", "review", "insufficient_history", "insufficient_scale", "insufficient_persistence_history", "unknown", "no_observations"] },
    "quality_state": { "type": "string" },
    "reasons": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "severity_basis": { "type": "string", "minLength": 1 },
    "not_medical_diagnosis": { "const": true },
    "current_value": { "type": ["number", "null"] },
    "baseline_value": { "type": ["number", "null"] },
    "robust_z": { "type": ["number", "null"] },
    "history_count": { "type": "integer", "minimum": 0 },
    "rejected_history_count": { "type": "integer", "minimum": 0 }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "review" } }, "required": ["status"] },
      "then": { "required": ["robust_z", "baseline_value", "current_value"], "properties": { "robust_z": { "type": "number" }, "baseline_value": { "type": "number" } } } },
    { "if": { "properties": { "status": { "enum": ["unknown", "no_observations"] } }, "required": ["status"] },
      "then": { "properties": { "robust_z": { "type": "null" } } } }
  ]
}
