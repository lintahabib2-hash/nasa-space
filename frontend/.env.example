# Where the dashboard reads data from:
#   fixtures - bundled, labeled SIMULATED scenarios (works offline and on a static host)
#   api      - Member 2's localhost API via the Vite /api proxy (sleep duration only today)
VITE_DATA_MODE=fixtures
# Optional: FastAPI backend (uvicorn backend.app.main:app --port 8000). When set, the app reads live
# data from it (falling back to the bundled snapshot) and also sends saved check-ins to it.
# VITE_API_BASE=http://127.0.0.1:8000

# Subject used in api mode
VITE_SUBJECT_ID=crew_01
